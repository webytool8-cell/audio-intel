# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon or Supabase recommended)
DATABASE_URL=postgresql://user:password@host:5432/audio_intel

# ─── Cron ─────────────────────────────────────────────────────────────────────
# Secret used to authenticate /api/cron/* endpoints
# Set as Bearer token in Authorization header from your cron scheduler
CRON_SECRET=your-cron-secret-here

# ─── AI Analysis (Phase 2) ────────────────────────────────────────────────────
# Anthropic API key — used by /api/clips for Claude Haiku clip analysis
# Without this, the system falls back to deterministic keyword-based analysis
ANTHROPIC_API_KEY=sk-ant-...
